// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   // "todo", "in-progress", "hitl", "done"
  agent       String   // "pm", "builder", "qa"
  priority    String   // "low", "medium", "high", "urgent"
  labels      String   // Comma-separated labels
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IssueAssignment {
  id         String   @id @default(uuid())
  issueId    String   @unique // Linear issue ID (e.g., "e2b77c2b-...")
  agentName  String   // "pm", "builder", "qa" — primary/dev assignee
  qaAgent    String?  // QA agent for review phase (e.g., "qa")
  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
