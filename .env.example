# NextAuth
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Simple Auth (Credentials)
AUTH_USERNAME=admin
AUTH_PASSWORD=demo123

# Demo Mode (set to "true" to use mock data instead of real gateway)
DEMO_MODE=true

# OpenClaw Gateway (not required in demo mode)
GATEWAY_URL=http://127.0.0.1:18789
GATEWAY_TOKEN=your-gateway-token-here

# Database
DATABASE_URL=file:./prisma/dev.db
